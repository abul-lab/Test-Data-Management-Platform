# Copy to .env when customizing local execution. Never commit .env.

# Bind host and port for the TDM Provisioning API & Web Console
TDM_HOST=127.0.0.1
TDM_PORT=4300

# Optional API key enforced via constant-time X-API-Key header check on /v1/*
TDM_API_KEY=

# Optional secret salt for deterministic HMAC-SHA256 relational tokenization
# (If unset, an ephemeral per-process cryptographic salt is generated on startup)
TDM_MASKING_SALT=

# Default TTL (seconds) before ephemeral CI/CD test sandboxes auto-expire
TDM_DEFAULT_TTL_SECONDS=3600

# Optional local model HTTP endpoint for AI-assisted field generation (offline-safe fallback enabled by default)
TDM_LOCAL_MODEL_URL=

